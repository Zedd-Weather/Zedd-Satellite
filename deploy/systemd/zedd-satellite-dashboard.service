[Unit]
Description=Zedd-Satellite dashboard
After=network-online.target zedd-satellite.service
Wants=network-online.target

[Service]
Type=simple
User=zedd-satellite
Group=zedd-satellite
WorkingDirectory=/opt/Zedd-Satellite
ExecStart=/usr/bin/python3 -m frontend --config /opt/Zedd-Satellite/config/settings.json --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/Zedd-Satellite/output /opt/Zedd-Satellite/logs /opt/Zedd-Satellite/config

[Install]
WantedBy=multi-user.target
